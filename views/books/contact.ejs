<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Liên Hệ - BookStore</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body>

    <nav class="navbar">
        <div class="container nav-content">
            <a href="/" class="logo"><i class="fas fa-book-open"></i> BOOKSTORE</a>
            <div class="nav-links">
                <a href="/">Trang chủ</a>
                <% if(typeof currentUser !== 'undefined' && currentUser) { %>
                    <a href="/cart">Giỏ hàng</a>s
                    <% if(currentUser.role === 'admin') { %>
                        <a href="/admin" style="color: #e74a3b;">Admin</a>
                    <% } %>
                    <a href="/logout">Thoát</a>
                <% } else { %>
                    <a href="/login" class="btn-login">Đăng nhập</a>
                <% } %>
            </div>
        </div>
    </nav>

    <div class="container">
        
        <div class="contact-wrapper">
            
            <div class="contact-info">
                <h3>Thông Tin Liên Hệ</h3>
                <p>Chúng tôi luôn sẵn sàng lắng nghe ý kiến đóng góp của bạn để cải thiện chất lượng dịch vụ tốt hơn.</p>
                
                <div class="info-item">
                    <i class="fas fa-map-marker-alt"></i>
                    <span>48 Xô Viết Nghệ Tĩnh, Hòa Cường Nam, Hải Châu, Đà Nẵng</span>
                </div>
                <div class="info-item">
                    <i class="fas fa-phone-alt"></i>
                    <span>0374094678</span>
                </div>
                <div class="info-item">
                    <i class="fas fa-envelope"></i>
                    <span>lenhotuan14092005@gmail.com</span>
                </div>
                <div class="info-item">
                    <i class="fas fa-clock"></i>
                    <span>8:00 - 22:00 (Hàng ngày)</span>
                </div>
            </div>

            <div class="contact-form">
                <h3>Gửi Tin Nhắn</h3>
                <form action="/contact" method="POST">
                    <div class="form-group">
                        <label>Họ và Tên</label>
                        <input type="text" class="form-control" name="name" 
                               value="<%= (typeof currentUser !== 'undefined' && currentUser) ? currentUser.username : '' %>" 
                               placeholder="Nhập tên của bạn..." required>
                    </div>
                    
                    <div class="form-group">
                        <label>Email</label>
                        <input type="email" class="form-control" name="email" 
                               value="<%= (typeof currentUser !== 'undefined' && currentUser) ? currentUser.email : '' %>"
                               placeholder="Nhập email..." required>
                    </div>

                    <div class="form-group">
                        <label>Nội dung</label>
                        <textarea class="form-control" name="message" placeholder="Bạn cần hỗ trợ gì?..." required></textarea>
                    </div>

                    <button type="submit" class="btn-send">
                        <i class="fas fa-paper-plane"></i> Gửi Ngay
                    </button>
                </form>
            </div>

        </div>
    </div>

</body>
</html>